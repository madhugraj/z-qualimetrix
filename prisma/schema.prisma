// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ============================================================================
// CORE TENANT & USER MANAGEMENT
// ============================================================================

model Tenant {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(100)
  domain           String?  @unique @db.VarChar(255)
  logoUrl          String?  @map("logo_url") @db.VarChar(500)
  settings         Json?    @default("{\"timezone\":\"UTC\",\"dateFormat\":\"YYYY-MM-DD\",\"defaultSprintLength\":14,\"workingDays\":[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\"]}")
  subscriptionTier String   @default("starter") @map("subscription_tier") @db.VarChar(50)
  maxUsers         Int      @default(10) @map("max_users")
  maxProducts      Int      @default(3) @map("max_products")
  trialEndsAt      DateTime? @map("trial_ends_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  products              Product[]
  tenantMemberships     TenantMembership[]
  users                 User[]
  workItems             WorkItem[]
  testCases             TestCase[]
  deliverables          ManualDeliverable[]
  sprints               Sprint[]

  @@index([slug])
  @@index([domain])
  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  email        String   @unique @db.VarChar(255)
  name         String?  @db.VarChar(255)
  avatarUrl    String?  @map("avatar_url") @db.VarChar(500)
  role         String   @default("viewer") @db.VarChar(50)
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantMemberships TenantMembership[]
  createdWorkItems  WorkItem[]        @relation("WorkItemCreator")
  updatedWorkItems  WorkItem[]        @relation("WorkItemUpdater")
  createdTestCases  TestCase[]        @relation("TestCaseCreator")
  updatedTestCases  TestCase[]        @relation("TestCaseUpdater")
  createdDeliverables ManualDeliverable[] @relation("DeliverableCreator")
  refreshTokens     RefreshToken[]

  @@index([email])
  @@map("users")
}

model TenantMembership {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  role                 String   @db.VarChar(50)
  accessibleProducts   String[] @default([]) @map("accessible_products") @db.Uuid
  defaultRole          String?  @map("default_role") @db.VarChar(50)
  defaultProductId     String?  @map("default_product_id") @db.Uuid
  notificationSettings Json?    @default("{\"email\":true,\"push\":false,\"slack\":false}") @map("notification_settings")
  invitedBy            String?  @map("invited_by") @db.Uuid
  joinedAt             DateTime @default(now()) @map("joined_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique @db.VarChar(500)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================================================
// PRODUCT MANAGEMENT
// ============================================================================

model Product {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  name               String   @db.VarChar(255)
  key                String   @db.VarChar(50)
  description        String?  @db.Text
  iconUrl            String?  @map("icon_url") @db.VarChar(500)
  color              String?  @db.VarChar(7)
  jiraProjectKey     String?  @map("jira_project_key") @db.VarChar(20)
  azureDevopsAreaPath String?  @map("azure_devops_area_path") @db.VarChar(255)
  settings           Json?    @default("{}")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItems    WorkItem[]
  testCases    TestCase[]
  deliverables ManualDeliverable[]
  sprints      Sprint[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([jiraProjectKey])
  @@map("products")
}

// ============================================================================
// WORK ITEMS & TEST CASES
// ============================================================================

model WorkItem {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  externalId        String?  @map("external_id") @db.VarChar(100)
  type              String   @db.VarChar(50)
  status            String   @db.VarChar(50)
  priority          String?  @db.VarChar(20)
  title             String   @db.VarChar(500)
  description       String?  @db.Text
  assigneeId        String?  @map("assignee_id") @db.Uuid
  sprintId          String?  @map("sprint_id") @db.Uuid
  storyPoints       Int?     @map("story_points")
  createdBy         String   @map("created_by") @db.Uuid
  updatedBy         String?  @map("updated_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz
  closedAt          DateTime? @map("closed_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sprint   Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  creator  User     @relation("WorkItemCreator", fields: [createdBy], references: [id])
  updater  User?    @relation("WorkItemUpdater", fields: [updatedBy], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([externalId])
  @@index([status])
  @@index([assigneeId])
  @@map("work_items")
}

model TestCase {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  externalId  String?  @map("external_id") @db.VarChar(100)
  name        String   @db.VarChar(500)
  description String?  @db.Text
  type        String   @default("functional") @db.VarChar(50)
  status      String   @default("draft") @db.VarChar(50)
  priority    String?  @db.VarChar(20)
  automationStatus String? @map("automation_status") @db.VarChar(50)
  createdBy   String   @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator    User       @relation("TestCaseCreator", fields: [createdBy], references: [id])
  updater    User?      @relation("TestCaseUpdater", fields: [updatedBy], references: [id])
  executions TestExecution[]

  @@index([tenantId])
  @@index([productId])
  @@index([externalId])
  @@index([status])
  @@map("test_cases")
}

model TestExecution {
  id          String   @id @default(uuid()) @db.Uuid
  testCaseId  String   @map("test_case_id") @db.Uuid
  status      String   @db.VarChar(20)
  executedBy  String   @map("executed_by") @db.Uuid
  executedAt  DateTime @default(now()) @map("executed_at") @db.Timestamptz
  notes       String?  @db.Text
  duration    Int?     // in seconds
  buildUrl    String?  @map("build_url") @db.VarChar(500)

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@index([status])
  @@map("test_executions")
}

// ============================================================================
// MANUAL DELIVERABLES
// ============================================================================

model ManualDeliverable {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  type        String   @db.VarChar(50) // demo, documentation, rca, training
  title       String   @db.VarChar(500)
  description String?  @db.Text
  metadata    Json?    @default("{}")
  rating      Float?   // for demos, 1-5
  links       String[] @default([])
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator  User     @relation("DeliverableCreator", fields: [createdBy], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([type])
  @@index([createdBy])
  @@map("manual_deliverables")
}

// ============================================================================
// SPRINT MANAGEMENT
// ============================================================================

model Sprint {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  name        String   @db.VarChar(255)
  externalId  String?  @map("external_id") @db.VarChar(100)
  status      String   @default("planning") @db.VarChar(50)
  startDate   DateTime @map("start_date") @db.Timestamptz
  endDate     DateTime @map("end_date") @db.Timestamptz
  goal        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItems  WorkItem[]

  @@index([tenantId])
  @@index([productId])
  @@index([status])
  @@map("sprints")
}