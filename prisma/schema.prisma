// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, vector, uuid_ossp]
}

// ============================================================================
// TENANT & ORGANIZATION MANAGEMENT
// ============================================================================

model Tenant {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(100)
  domain           String?  @unique @db.VarChar(255)
  logoUrl          String?  @map("logo_url") @db.VarChar(500)
  settings         Json?    @default("{\"timezone\":\"UTC\",\"dateFormat\":\"YYYY-MM-DD\",\"defaultSprintLength\":14,\"workingDays\":[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\"]}")
  subscriptionTier String   @default("starter") @map("subscription_tier") @db.VarChar(50)
  maxUsers         Int      @default(10) @map("max_users")
  maxProducts      Int      @default(3) @map("max_products")
  trialEndsAt      DateTime? @map("trial_ends_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  products              Product[]
  tenantMemberships     TenantMembership[]
  integrations          Integration[]
  webhookEvents         WebhookEvent[]
  workItems             WorkItem[]
  testCases             TestCase[]
  manualDeliverables    ManualDeliverable[]
  sprints               Sprint[]
  releases              Release[]
  qualityMetricsSnapshots QualityMetricsSnapshot[]
  teamPerformanceMetrics TeamPerformanceMetric[]
  backgroundJobs        BackgroundJob[]
  syncStates            SyncState[]
  auditLogs             AuditLog[]
  activityTimeline      ActivityTimeline[]
  notifications         Notification[]
  notificationPreferences NotificationPreference[]
  refreshTokens         RefreshToken[]
  userSettings          UserSettings[]
  aiModels              AIModel[]
  aiBudgets             AIBudget[]
  aiSettings            AISettings?
  tenantConfiguration   TenantConfiguration?
  alertRules            AlertRule[]
  alertIncidents        AlertIncident[]
  searchAnalytics       SearchAnalytics[]
  searchSuggestions     SearchSuggestion[]
  exportJobs            ExportJob[]
  reportTemplates       ReportTemplate[]
  scheduledReports      ScheduledReport[]
  reportLibrary         ReportLibrary[]
  ciPipelineIntegrations CIPipelineIntegration[]
  knowledgeSiloAnalysis  KnowledgeSiloAnalysis[]
  skillGaps             SkillGap[]
  teamHealthMetrics     TeamHealthMetrics[]
  workloadAnalysis       WorkloadAnalysis[]
  aiUsageSnapshots      AIUsageSnapshot[]
  alertMaintenanceWindows AlertMaintenanceWindow[]

  @@index([slug])
  @@index([domain])
  @@map("tenants")
}

model Product {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  name               String   @db.VarChar(255)
  key                String   @db.VarChar(50)
  description        String?  @db.Text
  iconUrl            String?  @map("icon_url") @db.VarChar(500)
  color              String?  @db.VarChar(7)
  jiraProjectKey     String?  @map("jira_project_key") @db.VarChar(20)
  azureDevopsAreaPath String?  @map("azure_devops_area_path") @db.VarChar(255)
  githubRepoFullName String?  @map("github_repo_full_name") @db.VarChar(255)
  settings           Json?    @default("{}")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItems           WorkItem[]
  testCases           TestCase[]
  manualDeliverables  ManualDeliverable[]
  sprints             Sprint[]
  releases            Release[]
  qualityMetricsSnapshots QualityMetricsSnapshot[]
  teamPerformanceMetrics TeamPerformanceMetric[]
  aiBudgets           AIBudget[]
  aiUsageSnapshots    AIUsageSnapshot[]
  alertIncidents      AlertIncident[]
  ciPipelineIntegrations CIPipelineIntegration[]
  knowledgeSiloAnalysis KnowledgeSiloAnalysis[]
  teamHealthMetrics    TeamHealthMetrics[]
  userSettingsDefaults UserSettings[]
  ciBuildRuns         CIBuildRun[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([jiraProjectKey])
  @@index([azureDevopsAreaPath])
  @@map("products")
}

// ============================================================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================================================

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique @db.VarChar(255)
  passwordHash      String?  @map("password_hash") @db.VarChar(255)
  authProvider      String   @default("local") @map("auth_provider") @db.VarChar(20)
  fullName          String?  @map("full_name") @db.VarChar(255)
  avatarUrl         String?  @map("avatar_url") @db.VarChar(500)
  timezone          String   @default("UTC") @db.VarChar(50)
  language          String   @default("en") @db.VarChar(10)
  googleId          String?  @map("google_id") @db.VarChar(255)
  githubId          String?  @map("github_id") @db.VarChar(255)
  samlIdp           String?  @map("saml_idp") @db.VarChar(255)
  emailVerified     Boolean  @default(false) @map("email_verified")
  isSystemAdmin     Boolean  @default(false) @map("is_system_admin")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenantMemberships  TenantMembership[]
  workItems          WorkItem[]          @relation("AssignedWorkItems")
  reportedWorkItems  WorkItem[]          @relation("ReportedWorkItems")
  workItemComments   WorkItemComment[]
  testCases          TestCase[]
  manualDeliverables ManualDeliverable[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  activityTimeline   ActivityTimeline[]
  notifications      Notification[]
  notificationPreferences NotificationPreference[]
  userSettings       UserSettings?
  aiUsageRecords     AIUsageRecord[]
  teamPerformanceMetrics TeamPerformanceMetric[]
  aiSettingsUpdater  AISettings?
  tenantConfigurationUpdater TenantConfiguration?
  featureFlags       FeatureFlag[]
  featureFlagUsages  FeatureFlagUsage[]
  alertCreator        AlertRule[]         @relation("AlertCreator")
  alertUpdater        AlertRule[]         @relation("AlertUpdater")
  incidentAcknowledger AlertIncident[]   @relation("IncidentAcknowledger")
  incidentResolver    AlertIncident[]   @relation("IncidentResolver")
  incidentFalsePositiveMarker AlertIncident[] @relation("IncidentFalsePositiveMarker")
  skillGaps           SkillGap[]

  @@index([email])
  @@index([googleId])
  @@index([githubId])
  @@map("users")
}

model TenantMembership {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  role                 String   @db.VarChar(50)
  accessibleProducts   String[] @default([]) @map("accessible_products") @db.Uuid
  defaultRole          String?  @map("default_role") @db.VarChar(50)
  defaultProductId     String?  @map("default_product_id") @db.Uuid
  notificationSettings Json?    @default("{\"email\":true,\"push\":false,\"slack\":false}") @map("notification_settings")
  invitedBy            String?  @map("invited_by") @db.Uuid
  joinedAt             DateTime @default(now()) @map("joined_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultProduct Product? @relation(fields: [defaultProductId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([role])
  @@map("tenant_memberships")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tenantId     String?   @map("tenant_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  deviceInfo   Json?     @map("device_info")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ============================================================================
// EXTERNAL INTEGRATION CONFIGURATIONS
// ============================================================================

model Integration {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  integrationType         String    @map("integration_type") @db.VarChar(50)
  clientId                String?   @map("client_id") @db.VarChar(255)
  clientSecretEncrypted   String?   @map("client_secret_encrypted") @db.Text
  accessTokenEncrypted    String?   @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted  String?   @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt         DateTime? @map("token_expires_at") @db.Timestamptz
  apiBaseUrl              String?   @map("api_base_url") @db.VarChar(500)
  webhookSecretEncrypted  String?   @map("webhook_secret_encrypted") @db.Text
  syncEnabled             Boolean   @default(true) @map("sync_enabled")
  syncFrequency           String    @default("15min") @map("sync_frequency") @db.VarChar(20)
  lastSyncAt              DateTime? @map("last_sync_at") @db.Timestamptz
  syncStatus              String    @default("pending") @map("sync_status") @db.VarChar(50)
  lastError               String?   @map("last_error") @db.Text
  errorCount              Int       @default(0) @map("error_count")
  lastSuccessfulSync      DateTime? @map("last_successful_sync") @db.Timestamptz
  configuration           Json?     @default("{}")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookEvents WebhookEvent[]
  syncStates    SyncState[]

  @@unique([tenantId, integrationType])
  @@index([tenantId])
  @@index([integrationType])
  @@map("integrations")
}

model WebhookEvent {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  integrationType   String   @map("integration_type") @db.VarChar(50)
  eventType         String   @map("event_type") @db.VarChar(100)
  rawPayload        Json     @map("raw_payload")
  processed         Boolean  @default(false)
  processingAttempts Int      @default(0) @map("processing_attempts")
  externalId        String?  @map("external_id") @db.VarChar(255)
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz
  processedAt       DateTime? @map("processed_at") @db.Timestamptz
  errorMessage      String?  @map("error_message") @db.Text

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [tenantId, integrationType], references: [tenantId, integrationType])

  @@index([tenantId])
  @@index([processed])
  @@index([externalId])
  @@map("webhook_events")
}

// ============================================================================
// WORK ITEMS & BUG INTELLIGENCE
// ============================================================================

model WorkItem {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  productId             String?  @map("product_id") @db.Uuid
  externalSystem        String?  @map("external_system") @db.VarChar(20)
  externalId            String?  @map("external_id") @db.VarChar(100)
  externalUrl           String?  @map("external_url") @db.VarChar(500)
  itemType              String   @map("item_type") @db.VarChar(20)
  status                String   @db.VarChar(50)
  priority              String?  @db.VarChar(10)
  title                 String   @db.VarChar(500)
  description           String?  @db.Text
  acceptanceCriteria    String?  @map("acceptance_criteria") @db.Text
  domain                String?  @db.VarChar(50)
  domainConfidence      Decimal? @map("domain_confidence") @db.Decimal(3,2)
  tags                  String[] @default([])
  component             String?  @db.VarChar(100)
  parentId              String?  @map("parent_id") @db.Uuid
  sprintId              String?  @map("sprint_id") @db.Uuid
  assigneeId            String?  @map("assignee_id") @db.Uuid
  reporterId            String?  @map("reporter_id") @db.Uuid
  resolution            String?  @db.VarChar(100)
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz
  resolutionDurationHours Decimal? @map("resolution_duration_hours") @db.Decimal(10,2)
  isEscapedDefect        Boolean  @default(false) @map("is_escaped_defect")
  isReopened            Boolean  @default(false) @map("is_reopened")
  qaRejectionCount       Int      @default(0) @map("qa_rejection_count")
  firstTimeFix           Boolean  @default(true) @map("first_time_fix")
  externalCreatedAt      DateTime? @map("external_created_at") @db.Timestamptz
  externalUpdatedAt      DateTime? @map("external_updated_at") @db.Timestamptz
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product             Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  parent               WorkItem?            @relation("WorkItemHierarchy", fields: [parentId], references: [id])
  children             WorkItem[]           @relation("WorkItemHierarchy")
  sprint               Sprint?              @relation(fields: [sprintId], references: [id])
  assignee             User?                @relation("AssignedWorkItems", fields: [assigneeId], references: [id])
  reporter             User?                @relation("ReportedWorkItems", fields: [reporterId], references: [id])
  similarSourceBugs    BugSimilarity[]     @relation("SourceBugs")
  similarTargetBugs    BugSimilarity[]     @relation("TargetBugs")
  comments             WorkItemComment[]
  attachments          WorkItemAttachment[]
  coveredByTestCases   TestCase[]          @relation("TestCaseCoveredStory")
  manualDeliverables   ManualDeliverable[]  @relation("WorkItemDeliverables")
  aiUsageRecords      AIUsageRecord[]

  @@unique([tenantId, externalSystem, externalId])
  @@index([tenantId])
  @@index([productId])
  @@index([externalSystem, externalId])
  @@index([itemType, status])
  @@index([assigneeId])
  @@index([sprintId])
  @@map("work_items")
}

model BugSimilarity {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  sourceBugId      String   @map("source_bug_id") @db.Uuid
  similarBugId     String   @map("similar_bug_id") @db.Uuid
  similarityScore  Decimal  @map("similarity_score") @db.Decimal(3,2)
  similarityMethod String   @default("tfidf") @map("similarity_method") @db.VarChar(50)
  userConfirmed    Boolean? @map("user_confirmed")
  userRejected     Boolean? @map("user_rejected")
  reviewedBy       String?  @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  sourceBug WorkItem @relation("SourceBugs", fields: [sourceBugId], references: [id], onDelete: Cascade)
  similarBug WorkItem @relation("TargetBugs", fields: [similarBugId], references: [id], onDelete: Cascade)

  @@unique([sourceBugId, similarBugId])
  @@index([sourceBugId])
  @@index([similarityScore])
  @@map("bug_similarities")
}

model WorkItemComment {
  id              String   @id @default(uuid()) @db.Uuid
  workItemId      String   @map("work_item_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  externalCommentId String? @map("external_comment_id") @db.VarChar(100)
  commentBody     String   @map("comment_body") @db.Text
  isInternal      Boolean  @default(false) @map("is_internal")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  externalCreatedAt DateTime? @map("external_created_at") @db.Timestamptz

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([workItemId])
  @@index([externalCommentId])
  @@map("work_item_comments")
}

model WorkItemAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  workItemId  String   @map("work_item_id") @db.Uuid
  fileName    String   @map("file_name") @db.VarChar(255)
  fileUrl     String   @map("file_url") @db.VarChar(500)
  fileSizeBytes BigInt  @map("file_size_bytes")
  mimeType    String?  @map("mime_type") @db.VarChar(100)
  externalAttachmentId String? @map("external_attachment_id") @db.VarChar(100)
  uploadedBy  String?  @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId])
  @@map("work_item_attachments")
}

// ============================================================================
// TEST MANAGEMENT & EXECUTION
// ============================================================================

model TestCase {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  externalSystem    String?  @map("external_system") @db.VarChar(20)
  externalId         String?  @map("external_id") @db.VarChar(100)
  externalUrl        String?  @map("external_url") @db.VarChar(500)
  name              String   @db.VarChar(500)
  description       String?  @db.Text
  testType          String   @default("functional") @map("test_type") @db.VarChar(50)
  automationStatus  String   @default("manual") @map("automation_status") @db.VarChar(20)
  coveredStoryIds   String[] @default([]) @map("covered_story_ids") @db.Uuid
  requirementIds    String[] @default([]) @map("requirement_ids") @db.VarChar(100)
  testSteps         Json?    @map("test_steps")
  priority          String?  @db.VarChar(10)
  tags              String[] @default([])
  component         String?  @db.VarChar(100)
  createdBy         String?  @map("created_by") @db.Uuid
  updatedBy         String?  @map("updated_by") @db.Uuid
  externalCreatedAt DateTime? @map("external_created_at") @db.Timestamptz
  externalUpdatedAt DateTime? @map("external_updated_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  creator      User?        @relation(fields: [createdBy], references: [id])
  updater      User?        @relation(fields: [updatedBy], references: [id])
  executions   TestExecution[]
  coveredWorkItems WorkItem[] @relation("TestCaseCoveredStory")

  @@unique([tenantId, externalSystem, externalId])
  @@index([tenantId])
  @@index([productId])
  @@index([coveredStoryIds])
  @@map("test_cases")
}

model TestExecution {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  testCaseId        String   @map("test_case_id") @db.Uuid
  executionRun      String?  @map("execution_run") @db.VarChar(100)
  sprintId          String?  @map("sprint_id") @db.Uuid
  environment       String   @default("QA") @db.VarChar(50)
  executedBy        String?  @map("executed_by") @db.Uuid
  status            String   @db.VarChar(20)
  durationSeconds   Int?     @map("duration_seconds")
  executionNotes    String?  @map("execution_notes") @db.Text
  failureReason     String?  @map("failure_reason") @db.VarChar(255)
  isFlake           Boolean  @default(false) @map("is_flake")
  externalRunId     String?  @map("external_run_id") @db.VarChar(100)
  externalTestId     String?  @map("external_test_id") @db.VarChar(100)
  executedAt        DateTime @default(now()) @map("executed_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  evidences TestExecutionEvidence[]

  @@index([tenantId])
  @@index([testCaseId])
  @@index([executionRun])
  @@index([sprintId])
  @@index([status])
  @@map("test_executions")
}

model TestExecutionEvidence {
  id             String   @id @default(uuid()) @db.Uuid
  testExecutionId String  @map("test_execution_id") @db.Uuid
  evidenceType    String  @map("evidence_type") @db.VarChar(20)
  fileUrl        String   @map("file_url") @db.VarChar(500)
  description    String?  @db.Text
  capturedAt     DateTime @default(now()) @map("captured_at") @db.Timestamptz

  testExecution TestExecution @relation(fields: [testExecutionId], references: [id], onDelete: Cascade)

  @@index([testExecutionId])
  @@map("test_execution_evidence")
}

// ============================================================================
// MANUAL DELIVERABLES & ACTIVITIES
// ============================================================================

model ManualDeliverable {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  deliverableType   String   @map("deliverable_type") @db.VarChar(20)
  title             String   @db.VarChar(500)
  description       String?  @db.Text
  metadata          Json?    @default("{}")
  externalUrls      String[] @default([]) @map("external_urls")
  relatedWorkItemIds String[] @default([]) @map("related_work_item_ids") @db.Uuid
  createdBy         String   @map("created_by") @db.Uuid
  deliveredAt       DateTime @map("delivered_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  creator    User       @relation(fields: [createdBy], references: [id])
  workItems  WorkItem[]  @relation("WorkItemDeliverables")
  collaborators DeliverableCollaborator[]

  @@index([tenantId])
  @@index([deliverableType])
  @@index([productId])
  @@index([createdBy])
  @@map("manual_deliverables")
}

model DeliverableCollaborator {
  id             String   @id @default(uuid()) @db.Uuid
  deliverableId  String   @map("deliverable_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String   @default("contributor") @db.VarChar(50)

  deliverable ManualDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, userId])
  @@index([deliverableId])
  @@map("deliverable_collaborators")
}

// ============================================================================
// SPRINTS & RELEASES
// ============================================================================

model Sprint {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  name              String   @db.VarChar(100)
  sequence          Int
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  state             String   @default("active") @db.VarChar(20)
  externalSystem    String?  @map("external_system") @db.VarChar(20)
  externalId        String?  @map("external_id") @db.VarChar(100)
  sprintGoal        String?  @map("sprint_goal") @db.Text
  retrospectiveNotes String? @map("retrospective_notes") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
