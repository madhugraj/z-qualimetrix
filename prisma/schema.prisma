model AlertRule {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  ruleName                 String   @unique @map("rule_name") @db.VarChar(100)
  ruleDescription          String?  @map("rule_description") @db.Text
  ruleCategory             String   @map("rule_category") @db.VarChar(50)
  metricType               String   @map("metric_type") @db.VarChar(50)
  operator                 String   @db.VarChar(10)
  thresholdValue           Decimal  @map("threshold_value") @db.Decimal(10,2)
  thresholdUnit            String   @map("threshold_unit") @db.VarChar(20)
  aggregationWindow        String   @map("aggregation_window") @db.VarChar(50)
  secondaryMetricType      String?  @map("secondary_metric_type") @db.VarChar(50)
  secondaryOperator        String?  @map("secondary_operator") @db.VarChar(10)
  secondaryThresholdValue  Decimal? @map("secondary_threshold_value") @db.Decimal(10,2)
  conditionLogic           String   @default("AND") @map("condition_logic") @db.VarChar(10)
  severity                 String   @default("warning") @db.VarChar(20)
  priority                 Int      @default(5)
  notificationChannels     Json?    @default("{\"email\":true,\"slack\":false,\"in_app\":true}")
  emailRecipients          String[] @default([]) @map("email_recipients") @db.VarChar(255)
  slackChannels            String[] @default([]) @map("slack_channels") @db.VarChar(100)
  notificationTitleTemplate String? @map("notification_title_template") @db.Text
  notificationBodyTemplate  String? @map("notification_body_template") @db.Text
  targetRoles              String[] @default([]) @map("target_roles") @db.VarChar(50)
  targetUsers              String[] @default([]) @map("target_users") @db.Uuid
  escalationEnabled        Boolean  @default(false) @map("escalation_enabled")
  escalationRules          Json?    @default("{}") @map("escalation_rules")
  cooldownPeriodMinutes   Int      @default(60) @map("cooldown_period_minutes")
  suppressionRules         Json?    @default("{}") @map("suppression_rules")
  autoResolve              Boolean  @default(true) @map("auto_resolve")
  autoResolveAfterMinutes  Int?     @map("auto_resolve_after_minutes")
  isEnabled               Boolean  @default(true) @map("is_enabled")
  lastTriggeredAt          DateTime? @map("last_triggered_at") @db.Timestamptz
  triggerCount             Int      @default(0) @map("trigger_count")
  lastResolvedAt           DateTime? @map("last_resolved_at") @db.Timestamptz
  createdBy                String?  @map("created_by") @db.Uuid
  updatedBy                String?  @map("updated_by") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incidents          AlertIncident[]
  creator            User?           @relation("AlertCreator", fields: [createdBy], references: [id])
  updater            User?           @relation("AlertUpdater", fields: [updatedBy], references: [id])

  @@unique([tenantId, ruleName])
  @@index([tenantId])
  @@index([isEnabled])
  @@index([severity])
  @@index([metricType])
  @@map("alert_rules")
}

model AlertIncident {
  id                    String   @id @default(uuid()) @db.Uuid
