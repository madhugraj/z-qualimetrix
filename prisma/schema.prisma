// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ============================================================================
// CORE TENANT & USER MANAGEMENT
// ============================================================================

model Tenant {
  id               String    @id @default(uuid()) @db.Uuid
  name             String    @db.VarChar(255)
  slug             String    @unique @db.VarChar(100)
  domain           String?   @unique @db.VarChar(255)
  logoUrl          String?   @map("logo_url") @db.VarChar(500)
  settings         Json?     @default("{\"timezone\":\"UTC\",\"dateFormat\":\"YYYY-MM-DD\",\"defaultSprintLength\":14,\"workingDays\":[\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\"]}")
  subscriptionTier String    @default("starter") @map("subscription_tier") @db.VarChar(50)
  maxUsers         Int       @default(10) @map("max_users")
  maxProducts      Int       @default(3) @map("max_products")
  trialEndsAt      DateTime? @map("trial_ends_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  products                  Product[]
  tenantMemberships         TenantMembership[]
  users                     User[]
  workItems                 WorkItem[]
  workItemLinks             WorkItemLink[]
  testCases                 TestCase[]
  deliverables              ManualDeliverable[]
  sprints                   Sprint[]
  githubIntegrations        GitHubIntegration[]
  aiUsageEvents             AiUsageEvent[]
  aiModelCatalogs           AiModelCatalog[]
  integrations              Integration[]
  integrationDelegations    IntegrationDelegation[]
  aiProviderKeyMappings     AiProviderKeyMapping[]
  aiProviderConnections     AiProviderConnection[]
  gpuComputeUsageEvents     GpuComputeUsageEvent[]
  aiProviderIdentities      AiProviderIdentity[]
  aiProviderRawEvents       AiProviderRawEvent[]
  aiProviderDailyActivities AiProviderDailyActivity[]
  aiProviderDeletionAudits  AiProviderDeletionAudit[]
  commits                   Commit[]
  commitAttributions        CommitAttribution[]

  @@index([slug])
  @@index([domain])
  @@map("tenants")
}

model User {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String?   @map("tenant_id") @db.Uuid
  email                  String    @unique @db.VarChar(255)
  name                   String?   @db.VarChar(255)
  avatarUrl              String?   @map("avatar_url") @db.VarChar(500)
  role                   String    @default("unassigned") @db.VarChar(50)
  isActive               Boolean   @default(true) @map("is_active")
  lastLoginAt            DateTime? @map("last_login_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  squad                  String?   @db.VarChar(100)
  aiIngestTokenHash      String?   @unique @map("ai_ingest_token_hash") @db.VarChar(64)
  aiIngestTokenCreatedAt DateTime? @map("ai_ingest_token_created_at") @db.Timestamptz
  passwordHash           String?   @map("password_hash") @db.VarChar(60)

  tenant                       Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantMemberships            TenantMembership[]
  createdWorkItems             WorkItem[]                @relation("WorkItemCreator")
  updatedWorkItems             WorkItem[]                @relation("WorkItemUpdater")
  createdTestCases             TestCase[]                @relation("TestCaseCreator")
  updatedTestCases             TestCase[]                @relation("TestCaseUpdater")
  createdDeliverables          ManualDeliverable[]       @relation("DeliverableCreator")
  refreshTokens                RefreshToken[]
  githubIntegrations           GitHubIntegration[]
  aiUsageEvents                AiUsageEvent[]
  integrations                 Integration[]
  delegationsGranted           IntegrationDelegation[]   @relation("DelegationGrantedBy")
  delegationsReceived          IntegrationDelegation[]   @relation("DelegationGrantee")
  aiProviderKeyMappings        AiProviderKeyMapping[]
  aiProviderConnectionsCreated AiProviderConnection[]    @relation("AiProviderConnectionCreator")
  aiProviderIdentities         AiProviderIdentity[]
  aiProviderDeletionAudits     AiProviderDeletionAudit[] @relation("AiProviderDeletionRequester")

  @@index([email])
  @@index([tenantId])
  @@map("users")
}

model TenantMembership {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  role                 String   @db.VarChar(50)
  accessibleProducts   String[] @default([]) @map("accessible_products") @db.Uuid
  defaultRole          String?  @map("default_role") @db.VarChar(50)
  defaultProductId     String?  @map("default_product_id") @db.Uuid
  notificationSettings Json?    @default("{\"email\":true,\"push\":false,\"slack\":false}") @map("notification_settings")
  invitedBy            String?  @map("invited_by") @db.Uuid
  joinedAt             DateTime @default(now()) @map("joined_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique @db.VarChar(500)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================================================
// PRODUCT MANAGEMENT
// ============================================================================

model Product {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  name                String   @db.VarChar(255)
  key                 String   @db.VarChar(50)
  description         String?  @db.Text
  iconUrl             String?  @map("icon_url") @db.VarChar(500)
  color               String?  @db.VarChar(7)
  jiraProjectKey      String?  @map("jira_project_key") @db.VarChar(20)
  jiraProjectId       String?  @map("jira_project_id") @db.VarChar(50)
  azureDevopsAreaPath String?  @map("azure_devops_area_path") @db.VarChar(255)
  settings            Json?    @default("{}")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productRepositories    ProductRepository[]
  workItems              WorkItem[]
  testCases              TestCase[]
  deliverables           ManualDeliverable[]
  sprints                Sprint[]
  integrationDelegations IntegrationDelegation[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([jiraProjectKey])
  @@map("products")
}

// ============================================================================
// WORK ITEMS & TEST CASES
// ============================================================================

model WorkItem {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  externalId         String?   @map("external_id") @db.VarChar(100)
  type               String    @db.VarChar(50)
  status             String    @db.VarChar(50)
  priority           String?   @db.VarChar(20)
  title              String    @db.VarChar(500)
  description        String?   @db.Text
  assigneeId         String?   @map("assignee_id") @db.Uuid
  sprintId           String?   @map("sprint_id") @db.Uuid
  storyPoints        Int?      @map("story_points")
  createdBy          String    @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamptz
  closedAt           DateTime? @map("closed_at") @db.Timestamptz
  externalSystem     String    @default("manual") @map("external_system") @db.VarChar(20)
  isActive           Boolean   @default(true) @map("is_active")
  lastSeenAtSourceAt DateTime? @map("last_seen_at_source_at") @db.Timestamptz
  externalMetadata   Json?     @default("{}") @map("external_metadata")
  labels             String[]  @default([])
  externalStatusName String?   @map("external_status_name") @db.VarChar(100)
  statusChangedAt    DateTime? @map("status_changed_at") @db.Timestamptz
  reopenCount        Int       @default(0) @map("reopen_count")
  /// text-embedding-3-small (1536 dims) over title+description, generated at sync time when
  /// content changes. Prisma list fields can't be nullable, so an empty array (the default)
  /// IS the "not embedded yet" sentinel — getSimilarBugs checks .length, never treats it as
  /// a real zero vector to compare against.
  embedding          Float[]   @default([])

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sprint    Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  creator   User           @relation("WorkItemCreator", fields: [createdBy], references: [id])
  updater   User?          @relation("WorkItemUpdater", fields: [updatedBy], references: [id])
  linksFrom WorkItemLink[] @relation("LinkSource")
  linksTo   WorkItemLink[] @relation("LinkTarget")

  @@unique([productId, externalSystem, externalId])
  @@index([tenantId])
  @@index([productId])
  @@index([externalId])
  @@index([status])
  @@index([assigneeId])
  @@index([externalSystem])
  @@map("work_items")
}

/// Native issue-link graph from the source system (Jira "relates to"/"is
/// tested by"/"blocks", Azure DevOps work item relations). Backs
/// Requirements Traceability: a story/epic's linked bugs and their status,
/// with no test-management tool involved — just real cross-issue links the
/// team already creates in Jira/ADO. `linkType` is the raw provider label
/// (e.g. "Tests", "Blocks", "Relates") since it's descriptive text shown to
/// the user, not a fixed enum this app enforces.
model WorkItemLink {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  sourceItemId String   @map("source_item_id") @db.Uuid
  targetItemId String   @map("target_item_id") @db.Uuid
  linkType     String   @map("link_type") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceItem WorkItem @relation("LinkSource", fields: [sourceItemId], references: [id], onDelete: Cascade)
  targetItem WorkItem @relation("LinkTarget", fields: [targetItemId], references: [id], onDelete: Cascade)

  @@unique([sourceItemId, targetItemId, linkType])
  @@index([tenantId])
  @@index([sourceItemId])
  @@index([targetItemId])
  @@map("work_item_links")
}

model TestCase {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  externalId       String?  @map("external_id") @db.VarChar(100)
  name             String   @db.VarChar(500)
  description      String?  @db.Text
  type             String   @default("functional") @db.VarChar(50)
  status           String   @default("draft") @db.VarChar(50)
  priority         String?  @db.VarChar(20)
  automationStatus String?  @map("automation_status") @db.VarChar(50)
  createdBy        String   @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator    User            @relation("TestCaseCreator", fields: [createdBy], references: [id])
  updater    User?           @relation("TestCaseUpdater", fields: [updatedBy], references: [id])
  executions TestExecution[]

  @@index([tenantId])
  @@index([productId])
  @@index([externalId])
  @@index([status])
  @@map("test_cases")
}

model TestExecution {
  id         String   @id @default(uuid()) @db.Uuid
  testCaseId String   @map("test_case_id") @db.Uuid
  status     String   @db.VarChar(20)
  executedBy String   @map("executed_by") @db.Uuid
  executedAt DateTime @default(now()) @map("executed_at") @db.Timestamptz
  notes      String?  @db.Text
  duration   Int? // in seconds
  buildUrl   String?  @map("build_url") @db.VarChar(500)

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@index([status])
  @@map("test_executions")
}

// ============================================================================
// MANUAL DELIVERABLES
// ============================================================================

model ManualDeliverable {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  type        String   @db.VarChar(50) // demo, documentation, rca, training
  title       String   @db.VarChar(500)
  description String?  @db.Text
  metadata    Json?    @default("{}")
  rating      Float? // for demos, 1-5
  links       String[] @default([])
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator User    @relation("DeliverableCreator", fields: [createdBy], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([type])
  @@index([createdBy])
  @@map("manual_deliverables")
}

// ============================================================================
// SPRINT MANAGEMENT
// ============================================================================

model Sprint {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  name               String    @db.VarChar(255)
  externalId         String?   @map("external_id") @db.VarChar(100)
  status             String    @default("planning") @db.VarChar(50)
  startDate          DateTime  @map("start_date") @db.Timestamptz
  endDate            DateTime  @map("end_date") @db.Timestamptz
  goal               String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  externalSystem     String    @default("manual") @map("external_system") @db.VarChar(20)
  isActive           Boolean   @default(true) @map("is_active")
  lastSeenAtSourceAt DateTime? @map("last_seen_at_source_at") @db.Timestamptz
  externalMetadata   Json?     @default("{}") @map("external_metadata")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  @@unique([productId, externalSystem, externalId])
  @@index([tenantId])
  @@index([productId])
  @@index([status])
  @@index([externalSystem])
  @@map("sprints")
}

// ============================================================================
// GITHUB INTEGRATION
// ============================================================================

model GitHubIntegration {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  encryptedToken       String    @map("encrypted_token") @db.Text
  tokenType            String    @map("token_type") @db.VarChar(50)
  githubUsername       String?   @map("github_username") @db.VarChar(255)
  lastValidated        DateTime? @map("last_validated") @db.Timestamptz
  lastUsed             DateTime? @map("last_used") @db.Timestamptz
  // Commit-sync scheduling (github-commit-sync.service.ts), mirroring the
  // due-check convention used by Integration/AiProviderConnection —
  // computed live from lastSyncedAt + syncFrequencyMinutes, not a stored
  // nextSyncAt column.
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz
  syncFrequencyMinutes Int       @default(60) @map("sync_frequency_minutes")
  isActive             Boolean   @default(true) @map("is_active")
  createdBy            String    @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@index([tenantId])
  @@index([isActive])
  @@map("github_integrations")
}

// ============================================================================
// PRODUCT-GITHUB REPOSITORY MAPPING
// ============================================================================

model ProductRepository {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  githubRepo String   @map("github_repo") @db.VarChar(255) // Format: "owner/repo"
  isPrimary  Boolean  @default(false) @map("is_primary")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  commits Commit[]

  @@unique([productId, githubRepo])
  @@index([productId])
  @@index([githubRepo])
  @@index([isActive])
  @@map("product_repositories")
}

// ============================================================================
// COMMIT ATTRIBUTION (AI vs human authorship)
// ============================================================================

// Real, persisted per-commit data — replaces the previous request-time-only,
// unpersisted GitHub API fetch. additions/deletions start null and are
// backfilled by github-commit-sync.service.ts's stats pass (per-commit detail
// calls are rate-limit-heavy, so they're batched separately from the cheap
// list-commits pass that creates the row).
model Commit {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  productRepositoryId String    @map("product_repository_id") @db.Uuid
  sha                 String    @db.VarChar(64)
  message             String    @db.Text
  authorName          String?   @map("author_name") @db.VarChar(255)
  authorEmail         String?   @map("author_email") @db.VarChar(255)
  authoredAt          DateTime  @map("authored_at") @db.Timestamptz
  url                 String    @db.Text
  additions           Int?
  deletions           Int?
  statsSyncedAt       DateTime? @map("stats_synced_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productRepository ProductRepository   @relation(fields: [productRepositoryId], references: [id], onDelete: Cascade)
  attributions      CommitAttribution[]

  @@unique([productRepositoryId, sha])
  @@index([tenantId, authoredAt])
  @@index([statsSyncedAt])
  @@map("commits")
}

// A commit can carry more than one attribution signal at different
// confidence tiers (e.g. an exact Claude-Code-hook report AND a
// self-tagged commit trailer for the same commit) — deliberately never
// collapsed into a single number. Consumers must display confidence tiers
// separately and prefer "exact" over "heuristic" when both exist.
model CommitAttribution {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  commitId        String   @map("commit_id") @db.Uuid
  confidence      String   @db.VarChar(20) // "exact" | "heuristic"
  tool            String   @db.VarChar(50) // e.g. "claude_code", "github_copilot" — freeform, matches AiProviderConnection.vendor convention
  source          String   @db.VarChar(50) // "claude_code_hook" | "trailer_detected"
  sessionId       String?  @map("session_id") @db.VarChar(255) // joined against AiUsageEvent.sessionId at query time for model enrichment; not duplicated at write time
  detectedTrailer String?  @map("detected_trailer") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commit Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@unique([commitId, source])
  @@index([tenantId])
  @@index([sessionId])
  @@map("commit_attributions")
}

// ============================================================================
// AI USAGE ANALYTICS
// ============================================================================

model AiUsageEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp DateTime? @default(now()) @map("timestamp") @db.Timestamptz
  sprint    String?   @db.VarChar(50)
  userId    String?   @map("user_id") @db.Uuid
  modelId   String    @map("model_id") @db.VarChar(100)
  activity  String?   @db.VarChar(50)
  tokensIn  Int       @map("tokens_in")
  tokensOut Int       @map("tokens_out")
  cachedIn  Int?      @default(0) @map("cached_in")
  latencyMs Int?      @map("latency_ms")
  accepted  Boolean?  @default(false)
  reworked  Boolean?  @default(false)
  tenantId  String?   @map("tenant_id") @db.Uuid
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Pull-based vendor sync support (OpenAI/Vertex usage-API adapters), added
  // alongside Claude Code's existing per-request push rows. provider defaults
  // to 'claude_code' so existing rows backfill for free. bucketStart/groupKey
  // are only set on pull-based aggregate rows; a hand-written partial unique
  // index on (tenantId, provider, modelId, bucketStart, groupKey) WHERE
  // bucketStart IS NOT NULL makes re-sync idempotent. Adapters must always
  // set a non-null groupKey when bucketStart is set — Postgres treats
  // NULL <> NULL, so a null groupKey would silently defeat the dedup index.
  provider    String    @default("claude_code") @db.VarChar(20)
  bucketStart DateTime? @map("bucket_start") @db.Timestamptz
  groupKey    String?   @map("group_key") @db.VarChar(255)

  providerConnectionId String?  @map("provider_connection_id") @db.Uuid
  providerIdentityId   String?  @map("provider_identity_id") @db.Uuid
  source               String   @default("event") @db.VarChar(50)
  externalEventId      String?  @map("external_event_id") @db.VarChar(255)
  sessionId            String?  @map("session_id") @db.VarChar(255)
  requestCount         Int      @default(1) @map("request_count")
  providerCostUsd      Decimal? @map("provider_cost_usd") @db.Decimal(18, 8)
  estimatedCostUsd     Decimal? @map("estimated_cost_usd") @db.Decimal(18, 8)
  costSource           String?  @map("cost_source") @db.VarChar(30)
  metadata             Json?    @default("{}")

  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant             Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  providerConnection AiProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  providerIdentity   AiProviderIdentity?   @relation(fields: [providerIdentityId], references: [id], onDelete: SetNull)

  @@index([timestamp], map: "idx_ai_usage_events_timestamp")
  @@index([userId], map: "idx_ai_usage_events_user_id")
  @@index([modelId], map: "idx_ai_usage_events_model_id")
  @@index([sprint], map: "idx_ai_usage_events_sprint")
  @@index([tenantId], map: "idx_ai_usage_events_tenant_id")
  @@index([activity], map: "idx_ai_usage_events_activity")
  @@index([provider], map: "idx_ai_usage_events_provider")
  @@index([providerConnectionId], map: "idx_ai_usage_events_provider_connection_id")
  @@index([providerIdentityId], map: "idx_ai_usage_events_provider_identity_id")
  @@map("ai_usage_events")
}

// A tenant-owned connection to one vendor organization/account. This is
// deliberately separate from Integration: a tenant may connect multiple
// Anthropic organizations and each can expose a different collection channel.
model AiProviderConnection {
  id                       String    @id @default(uuid()) @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  vendor                   String    @db.VarChar(50)
  product                  String    @default("claude_code") @db.VarChar(50)
  // Nullable: these four are Anthropic-specific vocabulary
  // (anthropic_direct/team/managed_otel, etc.) — a GCP/AWS/Azure connection
  // has no honest value for them. AiProviderConnectionService still requires
  // them for vendor:"anthropic" rows; provider-connection.service.ts (the
  // generic path every other vendor uses) never sets them.
  acquisitionChannel       String?   @map("acquisition_channel") @db.VarChar(50)
  planType                 String?   @map("plan_type") @db.VarChar(50)
  organizationName         String?   @map("organization_name") @db.VarChar(255)
  externalAccountId        String    @map("external_account_id") @db.VarChar(255)
  // The specific billing account/subscription this connection reads (GCP
  // billing account id, AWS payer account id, Azure subscription id) — a
  // tenant may connect more than one, so this also feeds usage-row
  // idempotency keys downstream, not just display.
  externalBillingAccountId String?   @map("external_billing_account_id") @db.VarChar(255)
  domain                   String?   @db.VarChar(255)
  collectionMode           String?   @map("collection_mode") @db.VarChar(50)
  authType                 String    @default("none") @map("auth_type") @db.VarChar(50)
  encryptedCredential      String?   @map("encrypted_credential") @db.Text
  credentialLabel          String?   @map("credential_label") @db.VarChar(255)
  telemetryTokenHash       String?   @unique @map("telemetry_token_hash") @db.VarChar(64)
  telemetryTokenCreatedAt  DateTime? @map("telemetry_token_created_at") @db.Timestamptz
  status                   String    @default("awaiting_configuration") @db.VarChar(40)
  scopes                   String[]  @default([])
  capabilities             Json      @default("{}")
  config                   Json      @default("{}")
  syncCursor               Json      @default("{}") @map("sync_cursor")
  syncFrequencyMinutes     Int       @default(60) @map("sync_frequency_minutes")
  lastValidatedAt          DateTime? @map("last_validated_at") @db.Timestamptz
  lastTelemetryAt          DateTime? @map("last_telemetry_at") @db.Timestamptz
  lastSyncedAt             DateTime? @map("last_synced_at") @db.Timestamptz
  lastSyncStartedAt        DateTime? @map("last_sync_started_at") @db.Timestamptz
  lastSyncError            String?   @map("last_sync_error") @db.Text
  isActive                 Boolean   @default(true) @map("is_active")
  createdBy                String    @map("created_by") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant                Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator               User                      @relation("AiProviderConnectionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  identities            AiProviderIdentity[]
  rawEvents             AiProviderRawEvent[]
  dailyActivities       AiProviderDailyActivity[]
  usageEvents           AiUsageEvent[]
  gpuComputeUsageEvents GpuComputeUsageEvent[]

  @@unique([tenantId, vendor, acquisitionChannel, externalAccountId], map: "ai_provider_connections_tenant_vendor_channel_account_key")
  @@index([tenantId, vendor])
  @@index([isActive, status])
  @@map("ai_provider_connections")
}

// Provider identities are observed from official API/telemetry records. They
// are not QualiMetrix login accounts; userId is populated only when an existing
// tenant user can be mapped safely.
model AiProviderIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  externalUserId String   @map("external_user_id") @db.VarChar(255)
  email          String?  @db.VarChar(255)
  displayName    String?  @map("display_name") @db.VarChar(255)
  userId         String?  @map("user_id") @db.Uuid
  firstSeenAt    DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt     DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  metadata       Json     @default("{}")

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection      AiProviderConnection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user            User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  rawEvents       AiProviderRawEvent[]
  dailyActivities AiProviderDailyActivity[]
  usageEvents     AiUsageEvent[]

  @@unique([connectionId, externalUserId])
  @@index([tenantId, email])
  @@index([userId])
  @@map("ai_provider_identities")
}

model AiProviderRawEvent {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  connectionId    String    @map("connection_id") @db.Uuid
  identityId      String?   @map("identity_id") @db.Uuid
  source          String    @db.VarChar(50)
  externalEventId String    @map("external_event_id") @db.VarChar(255)
  occurredAt      DateTime  @map("occurred_at") @db.Timestamptz
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz
  sessionId       String?   @map("session_id") @db.VarChar(255)
  schemaVersion   String    @default("1") @map("schema_version") @db.VarChar(20)
  payload         Json
  processedAt     DateTime? @map("processed_at") @db.Timestamptz
  processingError String?   @map("processing_error") @db.Text

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection AiProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  identity   AiProviderIdentity?  @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@unique([connectionId, source, externalEventId])
  @@index([tenantId, occurredAt])
  @@index([identityId])
  @@map("ai_provider_raw_events")
}

model AiProviderDailyActivity {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  connectionId        String   @map("connection_id") @db.Uuid
  identityId          String   @map("identity_id") @db.Uuid
  date                DateTime @db.Date
  product             String   @default("claude_code") @db.VarChar(50)
  source              String   @db.VarChar(50)
  sessionCount        Int      @default(0) @map("session_count")
  requestCount        Int      @default(0) @map("request_count")
  commits             Int      @default(0)
  pullRequests        Int      @default(0) @map("pull_requests")
  linesAdded          Int      @default(0) @map("lines_added")
  linesRemoved        Int      @default(0) @map("lines_removed")
  suggestionsAccepted Int      @default(0) @map("suggestions_accepted")
  suggestionsRejected Int      @default(0) @map("suggestions_rejected")
  toolMetrics         Json     @default("{}") @map("tool_metrics")
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection AiProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  identity   AiProviderIdentity   @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([connectionId, identityId, date, product, source])
  @@index([tenantId, date])
  @@map("ai_provider_daily_activities")
}

// Immutable receipt retained after a provider connection and all of its
// collected facts are physically deleted. It deliberately stores a one-way
// connection fingerprint rather than the provider organization ID or employee
// data that the PM requested us to erase.
model AiProviderDeletionAudit {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  requestedBy           String?  @map("requested_by") @db.Uuid
  vendor                String   @db.VarChar(50)
  product               String   @db.VarChar(50)
  connectionFingerprint String   @map("connection_fingerprint") @db.VarChar(64)
  reason                String   @db.VarChar(500)
  recordCounts          Json     @map("record_counts")
  status                String   @default("completed") @db.VarChar(30)
  requestedAt           DateTime @default(now()) @map("requested_at") @db.Timestamptz
  completedAt           DateTime @default(now()) @map("completed_at") @db.Timestamptz

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester User?  @relation("AiProviderDeletionRequester", fields: [requestedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, completedAt])
  @@index([connectionFingerprint])
  @@map("ai_provider_deletion_audits")
}

/// External GPU-compute rental spend (AWS/GCP/Azure GPU instances, and later
/// specialized GPU clouds) — deliberately separate from AiUsageEvent, which
/// is LLM-token-shaped and doesn't fit instance/region/GPU-hours data.
/// utilizationPct is null until a Monitoring/telemetry integration exists
/// per provider — never fabricated from cost data alone.
model GpuComputeUsageEvent {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  connectionId      String   @map("connection_id") @db.Uuid
  provider          String   @db.VarChar(30) // "gcp" | "aws" | "azure" | "krutrim" (more specialized clouds join later)
  externalAccountId String   @map("external_account_id") @db.VarChar(255)
  externalEventId   String   @map("external_event_id") @db.VarChar(255) // idempotent upsert key (provider's line-item/bucket id)
  date              DateTime @db.Timestamptz
  instanceType      String?  @map("instance_type") @db.VarChar(100)
  gpuType           String?  @map("gpu_type") @db.VarChar(50) // e.g. "A100-80GB" — best-effort parsed from SKU description, null if unparseable
  region            String?  @db.VarChar(100)
  squad             String?  @db.VarChar(100) // User.squad if resolvable, else null (unmapped — same honesty pattern as AI usage's unmapped identities)
  gpuHours          Float?   @map("gpu_hours")
  utilizationPct    Float?   @map("utilization_pct")
  costUsd           Float    @map("cost_usd")
  pricingModel      String?  @map("pricing_model") @db.VarChar(30) // "on_demand" | "spot" | "committed_use" — bigger cost swing than currency
  costSource        String   @map("cost_source") @db.VarChar(30) // "provider_billed" | "provider_estimated"
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection AiProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalEventId])
  @@index([tenantId, date])
  @@index([provider])
  @@map("gpu_compute_usage_events")
}

model AiModelCatalog {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelId       String    @map("model_id") @db.VarChar(100)
  name          String    @db.VarChar(255)
  vendor        String    @db.VarChar(100)
  purpose       String?
  priceIn       Decimal   @map("price_in") @db.Decimal(10, 4)
  priceOut      Decimal   @map("price_out") @db.Decimal(10, 4)
  cacheDiscount Decimal?  @default(0.9) @map("cache_discount") @db.Decimal(3, 2)
  isActive      Boolean?  @default(true) @map("is_active")
  tenantId      String?   @map("tenant_id") @db.Uuid
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // modelId uniqueness is enforced by two partial unique indexes added by hand
  // in the migration SQL (tenantId IS NOT NULL / tenantId IS NULL) — Postgres
  // treats NULL <> NULL, so a single composite @@unique([tenantId, modelId])
  // would silently allow duplicate global rows. Prisma's schema DSL can't
  // express a partial index, so it isn't declared here.
  @@index([modelId], map: "idx_ai_model_catalog_model_id")
  @@index([isActive], map: "idx_ai_model_catalog_is_active")
  @@index([tenantId, modelId])
  @@map("ai_model_catalog")
}

model AiUsageAnalytics {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visibility   String    @db.VarChar(20)
  userId       String    @map("user_id") @db.Uuid
  sprints      Int?      @default(7)
  generatedAt  DateTime? @default(now()) @map("generated_at") @db.Timestamptz
  totals       Json?     @default("{}")
  kpis         Json?     @default("[]")
  models       Json?     @default("[]")
  spendTrend   Json?     @default("[]") @map("spend_trend")
  tokenTrend   Json?     @default("[]") @map("token_trend")
  activityMix  Json?     @default("[]") @map("activity_mix")
  people       Json?     @default("[]")
  benchmarks   Json?     @default("{}")
  insights     Json?     @default("[]")
  canSeeCost   Boolean?  @default(true) @map("can_see_cost")
  canSeePeople Boolean?  @default(true) @map("can_see_people")

  @@index([userId], map: "idx_ai_usage_analytics_user_id")
  @@index([visibility], map: "idx_ai_usage_analytics_visibility")
  @@index([generatedAt], map: "idx_ai_usage_analytics_generated_at")
  @@map("ai_usage_analytics")
}

// ============================================================================
// JIRA / AZURE DEVOPS INTEGRATIONS (generic, provider-discriminated)
// ============================================================================

model Integration {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  provider String @db.VarChar(20) // 'jira' | 'azure_devops'
  status   String @default("connected") @db.VarChar(20) // connected|error|reauth_required|disconnected

  encryptedAccessToken  String    @map("encrypted_access_token") @db.Text
  encryptedRefreshToken String?   @map("encrypted_refresh_token") @db.Text
  tokenExpiresAt        DateTime? @map("token_expires_at") @db.Timestamptz
  scopes                String[]  @default([])

  externalMetadata      Json    @default("{}") @map("external_metadata") // Jira: {cloudId, siteUrl, storyPointsFieldId, statusMap}; ADO: {organization, accountId, statusMap}
  connectedAccountLabel String? @map("connected_account_label") @db.VarChar(255)

  syncFrequencyMinutes Int       @default(5) @map("sync_frequency_minutes")
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz
  lastSyncStartedAt    DateTime? @map("last_sync_started_at") @db.Timestamptz
  lastSyncError        String?   @map("last_sync_error") @db.Text
  isActive             Boolean   @default(true) @map("is_active")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@index([isActive])
  @@map("integrations")
}

// A PM-granted, revocable right for a PO to edit their own product's
// Jira/Azure DevOps project mapping (Product.jiraProjectKey/jiraProjectId/
// azureDevopsAreaPath) without ever touching the tenant-wide Integration's
// raw OAuth credentials. Modeled as a grant record rather than a role change
// so revoking it can't accidentally strip anything else the PO can do.
model IntegrationDelegation {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  granteeId  String    @map("grantee_id") @db.Uuid
  grantedBy  String    @map("granted_by") @db.Uuid
  capability String    @default("manage_product_mapping") @db.VarChar(50)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  grantee User    @relation("DelegationGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  granter User    @relation("DelegationGrantedBy", fields: [grantedBy], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@index([granteeId])
  @@map("integration_delegations")
}

// Attributes an org-level usage-API vendor's per-developer key/account id
// (e.g. OpenAI's api_key_id) to a QualiMetrix user, so pull-based usage sync
// (see openai-usage-sync.service.ts) can credit the right person instead of
// a per-tenant system user.
model AiProviderKeyMapping {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  provider      String   @db.VarChar(20)
  externalKeyId String   @map("external_key_id") @db.VarChar(255)
  userId        String   @map("user_id") @db.Uuid
  label         String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalKeyId])
  @@index([tenantId])
  @@map("ai_provider_key_mappings")
}
