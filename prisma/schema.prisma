  falsePositiveMarker User? @relation("IncidentFalsePositiveMarker", fields: [markedAsFalsePositiveBy], references: [id])
  deliveries   AlertNotificationDelivery[]

  @@index([tenantId])
  @@index([alertRuleId])
  @@index([incidentStatus])
  @@index([triggeredAt(sort: Desc)])
  @@map("alert_incidents")
}

