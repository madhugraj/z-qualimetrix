  product      Product?   @relation(fields: [affectedProductId], references: [id])
  sprint       Sprint?    @relation(fields: [affectedSprintId], references: [id])
  acknowledger User?      @relation("IncidentAcknowledger", fields: [acknowledgedBy], references: [id])
