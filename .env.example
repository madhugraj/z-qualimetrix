# Database
DATABASE_URL="postgresql://postgres@localhost:5432/qualimetrix?schema=public"

# Application
NODE_ENV="development"
PORT=3001
# Origin the frontend is served from — required by CORS once credentials:true
# is set (needed for any cookie-based auth). Set to the real deployed frontend
# URL in production (e.g. https://z-qualimetrix.lovable.app).
FRONTEND_ORIGIN="http://localhost:8080"

# Frontend-only: where the Express API lives. Read at build time by Vite
# (see src/lib/api-config.ts) — not a secret, safe to commit in .env.production.
# Leave unset for local dev (falls back to http://localhost:3001).
# VITE_API_URL="https://<your-api-host>"

# Server-only: trusted external HTTPS base URL used in organization-managed
# Claude Code telemetry settings. This must be reachable from employee devices.
# QualiMetrix deliberately does not trust the browser/Host header for an
# enterprise deployment package. Localhost remains available for local testing
# only; production managed-OTel connections fail closed when this is absent.
# QUALIMETRIX_PUBLIC_API_URL="https://api.qualimetrix.example.com"

# JWT Secret (generate a secure random string for production)
# Required — also signs the Jira/Azure DevOps OAuth `state` parameter, so a
# missing/short/placeholder value now fails the server at boot (see src/lib/jwt.ts).
# Generate one with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"

# Redis (optional, for caching and sessions)
REDIS_URL="redis://localhost:6379"

# Jira Cloud OAuth 2.0 (3LO) — required to connect Jira per-organization.
# Register an OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps
# and add the redirect URI below as an allowed callback URL on that app.
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI="http://localhost:3001/api/v1/integrations/jira/callback"

# Azure DevOps OAuth 2.0 — required to connect Azure DevOps per-organization.
# Register an app at https://app.vssps.visualstudio.com/app/register (the
# dedicated Azure DevOps OAuth app registration, not a general Entra ID/Azure AD
# app) and add the redirect URI below as its callback URL.
# Cloud only — Azure DevOps Server (on-prem) does not support this OAuth flow.
# AZURE_DEVOPS_CLIENT_ID=
# AZURE_DEVOPS_CLIENT_SECRET=
AZURE_DEVOPS_REDIRECT_URI="http://localhost:3001/api/v1/integrations/azure_devops/callback"

# AI Service Keys (optional) — only used by the standalone test-real-ai-usage.ts
# fixture script, not by the app itself. The PM/Leadership analytics
# assistant (src/api/services/assistant-chat.service.ts) does NOT use these:
# each tenant brings and pays for their own key, configured by a PM from
# Settings → AI Providers (src/api/services/assistant-provider-connection.service.ts),
# encrypted at rest — there is no platform-wide fallback key.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Encryption key for sensitive data (GitHub tokens, API keys, etc.)
# Generate a secure random key: openssl rand -base64 32
ENCRYPTION_KEY=your-super-secret-encryption-key-change-in-production-please-generate-secure-random-key

# GitHub Integration (optional - for GitInsights component)
# Generate a GitHub Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo (full control of private repositories), read:org (read org data)
# GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE
