# QualiMetrix Environment Variables

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/qualimetrix"

# API Server
PORT=3001
NODE_ENV=development

# GitHub Integration
# Generate a GitHub Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo (full control of private repositories), read:org (read org data)
GITHUB_TOKEN=ghp_your_github_token_here

# JWT Authentication (optional, for future use)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d