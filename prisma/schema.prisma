  acknowledgedAt        DateTime? @map("acknowledged_at") @db.Timestamptz
  acknowledgedNote      String?  @map("acknowledged_note") @db.Text
  resolvedBy            String?  @map("resolved_by") @db.Uuid
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz
  resolutionNote        String?  @map("resolution_note") @db.Text
  rootCause             String?  @map("root_cause") @db.Text
  markedAsFalsePositiveBy String? @map("marked_as_false_positive_by") @db.Uuid
  falsePositiveReason   String?  @map("false_positive_reason") @db.Text
  falsePositiveAt       DateTime? @map("false_positive_at") @db.Timestamptz
  businessImpact        String?  @map("business_impact") @db.Text
  affectedUsersCount    Int?     @map("affected_users_count")
  downtimeMinutes       Int?     @map("downtime_minutes")
  relatedWorkItemIds    String[] @default([]) @map("related_work_item_ids") @db.Uuid
  relatedIncidentIds    String[] @default([]) @map("related_incident_ids") @db.Uuid
  notificationSent      Boolean  @default(false) @map("notification_sent")
  notificationChannelsUsed String[] @default([]) @map("notification_channels_used") @db.VarChar(20)
  notificationFailedReason String? @map("notification_failed_reason") @db.Text
  triggeredAt           DateTime @default(now()) @map("triggered_at") @db.Timestamptz
