  tenantId                 String   @map("tenant_id") @db.Uuid
  userId                   String?  @map("user_id") @db.Uuid
  modelId                  String?  @map("model_id") @db.Uuid
  productId                String?  @map("product_id") @db.Uuid
  sprintId                 String?  @map("sprint_id") @db.Uuid
  snapshotType             String   @map("snapshot_type") @db.VarChar(20)
  snapshotDate             DateTime @map("snapshot_date") @db.Date
  totalInputTokens         BigInt   @default(0) @map("total_input_tokens")
  totalOutputTokens        BigInt   @default(0) @map("total_output_tokens")
  totalCachedTokens        BigInt   @default(0) @map("total_cached_tokens")
  totalRequests            Int      @default(0) @map("total_requests")
  totalCostUsd             Decimal  @default(0.0) @map("total_cost_usd") @db.Decimal(15,2)
  suggestionsAccepted     Int      @default(0) @map("suggestions_accepted")
  suggestionsTotal         Int      @default(0) @map("suggestions_total")
  acceptanceRate           Decimal? @map("acceptance_rate") @db.Decimal(5,2)
  aiAssistedOutputPercent  Decimal? @map("ai_assisted_output_percent") @db.Decimal(5,2)
  reworkRate               Decimal? @map("rework_rate") @db.Decimal(5,2)
  avgLatencyMs             Decimal? @map("avg_latency_ms") @db.Decimal(10,2)
  activityBreakdown        Json?    @default("{}") @map("activity_breakdown")
  calculatedAt             DateTime @default(now()) @map("calculated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  model    AIModel?  @relation(fields: [modelId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  sprint   Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  @@unique([tenantId, snapshotType, snapshotDate, userId, modelId, sprintId])
  @@index([tenantId])
  @@index([userId])
  @@index([sprintId])
  @@index([snapshotDate])
  @@map("ai_usage_snapshots")
}

